# Скопируй в .env (без .example) и заполни своими значениями.
# .env НЕ коммить в git — добавь его в .gitignore.

# ── Браузерные (попадают в собранный JS сайта — это ожидаемо и ОК,
#    потому что anon-ключ Supabase умеет только INSERT (RLS)) ───────────

# Пароль на страницу /vehicle-constructor. НЕ сам пароль, а его SHA-256
# хэш — получить: node scripts/hash-password.mjs "твой-пароль"
VITE_CONSTRUCTOR_PASSWORD_HASH=

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Серверные (НЕТ префикса VITE_ — в браузер никогда не попадают).
#    Используются: (1) serverless-функцией api/cloudinary-sign.js, которая
#    выдаёт конструктору подпись для signed-загрузки фото; (2) локальным
#    scripts/migrate-images-to-cloudinary.mjs. На проде задаются в
#    Vercel → Project Settings → Environment Variables, а не в .env. ────

# Cloudinary → Dashboard (Cloud name) и Settings → Access Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Базовая папка в Cloudinary. Итоговый путь фото машины:
# {CLOUDINARY_FOLDER}/vehicles/{category}/{slug}/{main|id-цвета}
CLOUDINARY_FOLDER=osnova

# Можно не задавать — если пусто, скрипт возьмёт VITE_SUPABASE_URL выше.
SUPABASE_URL=

# ВАЖНО: тут нужен service_role key (не anon!) — он даёт полный доступ
# к таблице в обход RLS, поэтому используется только локально, никогда
# в браузере/конструкторе и никогда не коммитится в репозиторий.
# НИКОГДА не переименовывай в VITE_SUPABASE_SERVICE_KEY — с префиксом
# VITE_ он попал бы в код сайта и стал бы виден всем.
SUPABASE_SERVICE_KEY=eyJhbGciOi...