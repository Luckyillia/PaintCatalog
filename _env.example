# Скопируй в .env (без .example) и заполни своими значениями.
# .env НЕ коммить в git — добавь его в .gitignore.

# ── Браузерные (попадают в собранный JS сайта — это ожидаемо и ОК,
#    потому что anon-ключ Supabase умеет только INSERT (RLS), а
#    Cloudinary-пресет — только upload) ─────────────────────────────

# Пароль на страницу /vehicle-constructor. НЕ сам пароль, а его SHA-256
# хэш — получить: node scripts/hash-password.mjs "твой-пароль"
VITE_CONSTRUCTOR_PASSWORD_HASH=

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Cloudinary → Dashboard (Cloud name) и Settings → Upload → Upload presets
VITE_CLOUDINARY_CLOUD=my-cloud
VITE_CLOUDINARY_PRESET=osnova-unsigned

# ── Серверные (используются только scripts/pull-vehicles.mjs на твоём
#    компьютере, в браузер никогда не попадают) ─────────────────────

# Можно не задавать — если пусто, скрипт возьмёт VITE_SUPABASE_URL выше.
SUPABASE_URL=

# ВАЖНО: тут нужен service_role key (не anon!) — он даёт полный доступ
# к таблице в обход RLS, поэтому используется только локально, никогда
# в браузере/конструкторе и никогда не коммитится в репозиторий.
# НИКОГДА не переименовывай в VITE_SUPABASE_SERVICE_KEY — с префиксом
# VITE_ он попал бы в код сайта и стал бы виден всем.
SUPABASE_SERVICE_KEY=eyJhbGciOi...
