# Скопируй в .env (без .example) и заполни своими значениями.
# .env НЕ коммить в git — добавь его в .gitignore.

# ── Браузерные (попадают в собранный JS сайта — это ожидаемо и ОК,
#    потому что после sql/lock-down-rls.sql anon-ключ умеет только
#    читать таблицы) ───────────────────────────────────────────────────

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Необязательно. Абсолютный адрес сайта для og:image (превью ссылки в
# соцсетях), например https://osnova.vercel.app. Если пусто, на Vercel
# подставится production-домен проекта автоматически.
VITE_SITE_URL=

# ── Серверные (НЕТ префикса VITE_ — в браузер никогда не попадают).
#    На проде задаются в Vercel → Project Settings → Environment
#    Variables, локально — в .env (их читает и `npm run dev`).

# Админы: "Имя:sha256хэш;Другое:sha256хэш". Хэш и готовую запись даёт
#   node scripts/hash-password.mjs "Имя" "пароль"
# Имя из этой строки подставляется в лог правок (edited_by).
ADMIN_USERS=

# Случайная строка от 32 символов — подпись токенов сессии, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Если сменить её, все текущие сессии админов сразу разлогинятся.
ADMIN_SESSION_SECRET=

# Остальное ниже используется serverless-функциями api/* и локальными
# скриптами scripts/migrate-*.mjs.

# Cloudinary → Dashboard (Cloud name) и Settings → Access Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Базовая папка в Cloudinary. Итоговый путь фото машины:
# {CLOUDINARY_FOLDER}/vehicles/{category}/{slug}/{main|id-цвета}
CLOUDINARY_FOLDER=osnova

# Можно не задавать — если пусто, возьмётся VITE_SUPABASE_URL выше.
SUPABASE_URL=

# ВАЖНО: тут нужен service_role key (не anon!) — он даёт полный доступ
# к таблицам в обход RLS. Через него пишет api/admin-db.js (после проверки
# токена админа) и локальные скрипты миграции. Никогда в браузере и
# никогда не коммитится в репозиторий.
# НИКОГДА не переименовывай в VITE_SUPABASE_SERVICE_KEY — с префиксом
# VITE_ он попал бы в код сайта и стал бы виден всем.
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ── Уведомления о новых репортах (необязательно) ──────────────────────
# Webhook Discord или Slack: создай его в настройках канала.
REPORT_WEBHOOK_URL=
# Или Telegram: токен бота от @BotFather и id чата (бот должен быть в чате).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
